<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="All-Time Statistics" />
        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#808080" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="12dp" android:layout_margin="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="10sp" android:textStyle="bold" android:text="Months Tracked" />
                <TextView android:id="@+id/stat1_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:paddingTop="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="12dp" android:layout_margin="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="10sp" android:textStyle="bold" android:text="Total Completions" />
                <TextView android:id="@+id/stat2_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:paddingTop="4dp" />
            </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="12dp" android:layout_margin="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="10sp" android:textStyle="bold" android:text="All-Time Rate" />
                <TextView android:id="@+id/stat3_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:paddingTop="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="12dp" android:layout_margin="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="10sp" android:textStyle="bold" android:text="Longest Streak" />
                <TextView android:id="@+id/stat4_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:paddingTop="4dp" />
            </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/widget_card" android:padding="12dp" android:layout_margin="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#808080" android:textSize="10sp" android:textStyle="bold" android:text="Best Habit" />
        <TextView android:id="@+id/best_habit_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:paddingTop="4dp" />
        <TextView android:id="@+id/best_habit_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#808080" android:textSize="10sp" android:paddingTop="2dp" />
    </LinearLayout>
</LinearLayout>
