<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="Task Reports" />
        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#808080" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/widget_card" android:padding="12dp" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:text="Daily Tasks" />
            <TextView android:id="@+id/daily_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/daily_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#808080" android:textSize="10sp" android:paddingTop="2dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/widget_card" android:padding="12dp" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:text="Weekly Tasks" />
            <TextView android:id="@+id/weekly_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/weekly_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#808080" android:textSize="10sp" android:paddingTop="2dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/widget_card" android:padding="12dp" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:text="Monthly Tasks" />
            <TextView android:id="@+id/monthly_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/monthly_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#808080" android:textSize="10sp" android:paddingTop="2dp" />
    </LinearLayout>
</LinearLayout>
