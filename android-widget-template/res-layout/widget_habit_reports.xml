<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="Habit Summary" />
        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#808080" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="10dp" android:layout_margin="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" android:textStyle="bold" android:text="Total Habits" />
                <TextView android:id="@+id/sum1_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:paddingTop="2dp" />
                <TextView android:id="@+id/sum1_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="10dp" android:layout_margin="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" android:textStyle="bold" android:text="Best Habit" />
                <TextView android:id="@+id/sum2_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:paddingTop="2dp" />
                <TextView android:id="@+id/sum2_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/widget_card" android:padding="10dp" android:layout_margin="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" android:textStyle="bold" android:text="Best Streak" />
                <TextView android:id="@+id/sum3_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:paddingTop="2dp" />
                <TextView android:id="@+id/sum3_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#808080" android:textSize="9sp" />
            </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/hrow1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/widget_card" android:padding="10dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/hrow1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/hrow1_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#b8b8b8" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/hrow2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/widget_card" android:padding="10dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/hrow2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/hrow2_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#b8b8b8" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/hrow3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/widget_card" android:padding="10dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/hrow3_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/hrow3_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#b8b8b8" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/hrow4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/widget_card" android:padding="10dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/hrow4_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/hrow4_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#b8b8b8" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#808080" android:textSize="11sp" android:paddingTop="8dp" android:gravity="center" android:text="No habits yet" android:visibility="gone" />
</LinearLayout>
