<!-- Tap-to-toggle broadcast receiver — writes pending habit toggles into
     SharedPreferences and refreshes affected widgets. -->
<receiver android:name="com.habitracker.app.widgets.HabitToggleReceiver" android:enabled="true" android:exported="false"/>

<!-- Boot receiver — restores periodic widget refresh after device reboot -->
<receiver android:name="com.habitracker.app.widgets.BootReceiver" android:enabled="true" android:exported="true" android:directBootAware="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
    </intent-filter>
</receiver>

<!-- AlarmManager target — fires every 30 min to refresh all widgets -->
<receiver android:name="com.habitracker.app.widgets.WidgetAlarmReceiver" android:enabled="true" android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.DATE_CHANGED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
    </intent-filter>
</receiver>

<!-- Backing service for the Monthly Tracking Grid ListView (collection widget) -->
<service android:name="com.habitracker.app.widgets.MonthGridRemoteViewsService"
    android:permission="android.permission.BIND_REMOTEVIEWS"
    android:exported="false"/>

<!-- Dialog screen for writing/editing a calendar note straight from the widget -->
<activity android:name="com.habitracker.app.widgets.NoteEditorActivity"
    android:exported="false"
    android:excludeFromRecents="true"
    android:launchMode="singleTop"
    android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"/>
<activity android:name="com.habitracker.app.widgets.MonthPickerActivity"
    android:exported="false"
    android:excludeFromRecents="true"
    android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"/>
